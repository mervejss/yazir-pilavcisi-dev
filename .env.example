# Google Maps (canlı kurye haritası + yol çizimi). Boş bırakılırsa temel gömülü harita gösterilir.
# Google Cloud'da şunları etkinleştirin: Maps JavaScript API, Geocoding API, Places API (New)
# (Directions API isteğe bağlı: yoksa kurye haritasında kuş uçuşu çizgi gösterilir)
# Anahtarı "HTTP referrer" ile alan adınıza kısıtlayın.
VITE_GOOGLE_MAPS_API_KEY=
